{
  "name": "comic-guestbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A guestbook where every entry is a panel in one never-ending comic strip, in the style of Microsoft Comic Chat.",
  "scripts": {
    "art": "node tools/convert-art.mjs",
    "dev": "wrangler dev",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply comic-guestbook --local",
    "db:remote": "wrangler d1 migrations apply comic-guestbook --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@fontsource/comic-neue": "^5.3.0",
    "@types/node": "^26.6.4",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
