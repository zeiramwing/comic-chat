{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comic-guestbook",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // Static site (the comic strip UI + converted art). Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comic-guestbook",
      "database_id": "9df04b2c-2f3c-4592-a723-92f73e2097ce",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // The account with this username becomes the owner (moderator). If left
    // empty, the FIRST account to register becomes the owner.
    "OWNER_USERNAME": "",
    // Also set the secret OWNER_SETUP_TOKEN (`npx wrangler secret put OWNER_SETUP_TOKEN`)
    // so nobody can claim the owner account before you do; see README.
    "SITE_NAME": "Comic Guestbook"
  }

  // Serve it on your own domain (the zone must be on your Cloudflare account):
  // , "routes": [{ "pattern": "guestbook.example.com", "custom_domain": true }]
}
